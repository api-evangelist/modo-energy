  "info": {
    "_postman_id": "93440368-e340-4d81-b272-359e8051e4e3",
    "name": "Modo Energy ERCOT NEM API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Modo Energy's public API for battery operators, owners, and utilities to\nconsume energy market data. RESTful, JSON-encoded; authenticated via an\n`X-Token` header. Public API rate limit is 1000 requests per minute.\n\nEndpoint structure: `api.modoenergy.com/pub/v1/{locale}/{source}/{datapoint}`.\n\n\nContact Support:\n Name: Modo Energy",
      "type": "text/plain"
    }
  }
